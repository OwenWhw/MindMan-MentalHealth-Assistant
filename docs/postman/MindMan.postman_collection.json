{
  "info": {
    "name": "MindMan 接口测试",
    "description": "心理健康助手 MindMan 接口测试集合（配合 docs/测试手册-手把手.md 使用）\n\n使用顺序：\n1. 先跑「01-认证 / 登录」——它会自动把 token 写入集合变量，后续请求自动携带\n2. 再按 02~06 分组依次执行\n3. 每个请求的 Tests 标签页里都有断言脚本，可在 Test Results 查看通过情况\n\n环境变量：baseUrl / token / sessionId 均由脚本自动维护",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "articleId", "value": "1" }
  ],
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "01-认证",
      "item": [
        {
          "name": "登录（自动保存 token）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 状态码为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('业务码为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('返回了 token', function () { pm.expect(json.data.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', json.data.token);",
                  "console.log('已保存 token，有效期至 ' + json.data.expiresAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "获取当前用户（需 token）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('用户名是 admin', function () { pm.expect(json.data.username).to.eql('admin'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "异常-错误密码（预期被拒）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('被拒绝（业务码非 200）', function () { pm.expect(pm.response.json().code).to.not.eql(200); });",
                  "pm.test('提示密码错误', function () { pm.expect(pm.response.json().message).to.include('密码'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "异常-不带 token 访问（预期 HTTP 401）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 状态码为 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02-情绪管理",
      "item": [
        {
          "name": "情绪花园列表",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "pm.test('业务码 200', function () { pm.expect(json.code).to.eql(200); });",
            "pm.test('返回数组', function () { pm.expect(json.data).to.be.an('array'); });",
            "console.log('花园花朵数：' + json.data.length);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/emotion/garden", "host": ["{{baseUrl}}"], "path": ["api", "emotion", "garden"] }
          }
        },
        {
          "name": "种下今日心情（写入）",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('业务码 200', function () { pm.expect(pm.response.json().code).to.eql(200); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"emotion\": \"平静\",\n  \"content\": \"Postman 手工测试写入\",\n  \"emotionScore\": 3,\n  \"sleepScore\": 4,\n  \"stressScore\": 2,\n  \"trigger\": \"接口测试\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/emotion/garden", "host": ["{{baseUrl}}"], "path": ["api", "emotion", "garden"] }
          }
        },
        {
          "name": "情绪日记分页",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "pm.test('分页结构完整', function () { pm.expect(json.data).to.have.property('total'); pm.expect(json.data).to.have.property('list'); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/emotion/diary/page?page=1&pageSize=5",
              "host": ["{{baseUrl}}"], "path": ["api", "emotion", "diary", "page"],
              "query": [{ "key": "page", "value": "1" }, { "key": "pageSize", "value": "5" }]
            }
          }
        },
        {
          "name": "本周情绪洞察",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('业务码 200', function () { pm.expect(pm.response.json().code).to.eql(200); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/emotion/insight/this-week", "host": ["{{baseUrl}}"], "path": ["api", "emotion", "insight", "this-week"] }
          }
        }
      ]
    },
