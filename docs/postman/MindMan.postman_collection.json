        {
          "name": "同步对话（会真实调用大模型，较慢）",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "pm.test('业务码 200', function () { pm.expect(json.code).to.eql(200); });",
            "const ai = (json.data || []).filter(m => m.role === 'assistant').pop();",
            "pm.test('收到 AI 回复', function () { pm.expect(ai && ai.content).to.be.a('string').and.not.empty; });",
            "console.log('AI 回复片段：' + (ai ? ai.content.slice(0, 80) : ''));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"content\": \"我最近总是失眠，白天很累，有什么建议吗？\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/chat/messages", "host": ["{{baseUrl}}"], "path": ["api", "chat", "messages"] }
