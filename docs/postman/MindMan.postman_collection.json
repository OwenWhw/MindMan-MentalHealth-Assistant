          }
        },
        {
          "name": "创建会话（自动保存 sessionId）",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "const d = json.data;",
            "const sid = (d && typeof d === 'object') ? d.id : d;",
            "pm.test('返回会话 id', function () { pm.expect(sid).to.be.a('number'); });",
            "pm.collectionVariables.set('sessionId', sid);",
            "console.log('已保存 sessionId = ' + sid);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/chat/sessions", "host": ["{{baseUrl}}"], "path": ["api", "chat", "sessions"] }
          }
        },
