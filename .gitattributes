# 统一换行符：仓库内存储 LF，检出时按平台转换
* text=auto eol=lf

# 二进制文件，禁止换行符转换与 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.mp3  binary
*.wav  binary
*.ogg  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.jar   binary

# 锁定文件保持 LF，避免 CI diff 噪音
package-lock.json -diff linguist-generated=true
