# Docker Compose 本地演示配置；复制为 .env 后再按需修改。
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=mindman
MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_PORT=8848
BACKEND_PORT=8080
FRONTEND_PORT=80

# 生产环境务必替换为至少 32 字节的随机字符串。
JWT_SECRET=change-this-to-a-long-random-secret-before-production

# 配置云端 AI 或启用可连接的 Ollama；未配置可用模型时 AI 请求会报不可用。
AI_PROVIDER=auto
AI_BAILIAN_API_KEY=
AI_OLLAMA_ENABLED=false
AI_RAG_ENABLED=false
