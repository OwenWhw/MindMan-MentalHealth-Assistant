{
  "info": {
    "name": "MindMan API 冒烟测试",
    "description": "真实后端：登录、当前用户、情绪花园查询、非法评分校验。使用专门的测试账号，不写入有效花园记录。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "01 登录并保存 token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('登录 HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('登录业务码 200 且返回 token', () => { pm.expect(body.code).to.eql(200); pm.expect(body.data.token).to.be.a('string').and.not.empty; });",
            "if (body.code === 200 && body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
          ]
        }
      }]
    },
    {
      "name": "02 查询当前用户",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('当前用户 HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('返回已登录的测试用户', () => { pm.expect(body.code).to.eql(200); pm.expect(body.data.username).to.eql(pm.environment.get('username')); });"
          ]
        }
      }]
    },
    {
      "name": "03 查询情绪花园",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/emotion/garden"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('花园查询 HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('花园数据为数组', () => { pm.expect(body.code).to.eql(200); pm.expect(body.data).to.be.an('array'); });",
            "if (body.code === 200 && Array.isArray(body.data)) pm.collectionVariables.set('gardenBeforeIds', JSON.stringify(body.data.map(item => item.flowerId).sort()));"
          ]
        }
      }]
    },
    {
      "name": "04 非法评分被拒绝",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"emotion\":\"平静\",\"content\":\"接口测试：非法评分应被拒绝\",\"emotionScore\":0,\"sleepScore\":3,\"stressScore\":3}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/emotion/garden"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('非法评分 HTTP 400', () => pm.response.to.have.status(400));",
            "const body = pm.response.json();",
            "pm.test('返回参数错误且无创建结果', () => { pm.expect(body.code).to.eql(400); pm.expect(body.data).to.be.undefined; });"
          ]
        }
      }]
    },
    {
      "name": "05 非法评分后复查花园",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/emotion/garden"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('复查 HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('非法评分没有新增花朵', () => { pm.expect(body.code).to.eql(200); pm.expect(body.data).to.be.an('array'); pm.expect(JSON.stringify(body.data.map(item => item.flowerId).sort())).to.eql(pm.collectionVariables.get('gardenBeforeIds')); });"
          ]
        }
      }]
    }
  ]
}
